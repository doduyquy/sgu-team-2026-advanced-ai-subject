{
  "metadata": {
    "contract_name": "AgentContractV1",
    "spec_version": "1.2.0",
    "status": "SANDBOX-EXTENSION-PENDING-AUDIT",
    "gate": "Gate 6 (Research Platform V1)",
    "pinned_metadrive_commit": "85e5dadc6c7436d324348f6e3d8f8e680c06b4db",
    "pinned_metadrive_version": "0.4.3"
  },
  "information_profiles": {
    "main_profile_id": "STATE_DECISION_V1",
    "certified_profiles": [
      "STATE_DECISION_V1",
      "CORE_ONLY_V1"
    ],
    "parity_principle": "Every benchmark-compliant agent receives the exact same AgentInputV1 under a declared profile. No hidden platform privileges based on algorithm family or stage label."
  },
  "runtime_vs_serialized_surface": {
    "runtime_object_surface": "Exposes both high-level structured immutable objects (CoreObservationV1, TrafficActorV1, RouteWaypointV1) and high-performance read-only NumPy array views (actors_array, waypoints_array, validity_mask).",
    "serialized_surface": "Produces JSON-safe nested dictionaries via to_dict(); redundant array views are omitted from serialization to maintain clean data payloads."
  },
  "runtime_dataclass_schemas": {
    "AgentInputV1": [
      "profile_id",
      "core_observation",
      "traffic_context",
      "task_context",
      "step_index",
      "ego_motion"
    ],
    "CoreObservationV1": [
      "features"
    ],
    "TrafficActorV1": [
      "relative_position_x",
      "relative_position_y",
      "relative_velocity_x",
      "relative_velocity_y",
      "relative_heading",
      "length",
      "width"
    ],
    "TrafficContextV1": [
      "capacity",
      "radius_m",
      "actors",
      "actors_array",
      "validity_mask",
      "active_count",
      "overflow_count",
      "motion_paths",
      "motion_paths_overflow_count"
    ],
    "ActorPathV1": [
      "actor_slot",
      "branch_id",
      "points"
    ],
    "RouteWaypointV1": [
      "lookahead_distance_m",
      "relative_x",
      "relative_y",
      "relative_heading"
    ],
    "TaskContextV1": [
      "lookahead_count",
      "lookahead_spacing_m",
      "lookahead_range_m",
      "current_lane_width",
      "navigation_goal_direction",
      "waypoints",
      "waypoints_array",
      "validity_mask",
      "route_end_within_lookahead",
      "decision_point",
      "route_passage"
    ],
    "RoadDecisionPointV1": [
      "point_id",
      "distance_m",
      "available_turns"
    ],
    "EgoMotionV1": [
      "displacement_x_m",
      "displacement_y_m",
      "heading_delta_rad",
      "velocity_x_mps",
      "velocity_y_mps",
      "lane_heading_error_rad"
    ],
    "RoutePassageV1": [
      "passage_id",
      "branch_id",
      "kind",
      "entry_distance_m",
      "exit_distance_m",
      "maneuver",
      "yield_distance_m",
      "conflict_exit_distance_m"
    ],
    "AgentPublicEpisodeContext": [
      "control_frequency_hz",
      "control_dt_s",
      "horizon_steps",
      "input_profile_id",
      "action_adapter_id",
      "mode"
    ],
    "AgentDescriptor": [
      "agent_id",
      "agent_version",
      "input_profile_id",
      "action_adapter_id",
      "inference_stochasticity",
      "stateful_within_episode",
      "method_family"
    ],
    "AgentDecision": [
      "action_payload",
      "diagnostics"
    ]
  },
  "agent_input_schema": {
    "core_observation": {
      "dimensions": 259,
      "dtype": "float32",
      "normalized_range": [
        0.0,
        1.0
      ],
      "bounds_tolerance": 0.0001,
      "subvectors": {
        "ego_state": [
          0,
          9
        ],
        "navigation_checkpoints": [
          9,
          19
        ],
        "lidar_rays": [
          19,
          259
        ]
      },
      "derived_views": [
        "ego_state",
        "navigation_vector",
        "lidar_points"
      ],
      "immutability": "read-only defensive array copy (writeable=False)"
    },
    "traffic_context": {
      "capacity": 8,
      "radius_m": 50.0,
      "actor_features_dim": 7,
      "actor_features": [
        "relative_position_x",
        "relative_position_y",
        "relative_velocity_x",
        "relative_velocity_y",
        "relative_heading",
        "length",
        "width"
      ],
      "actors_tuple_length": 8,
      "actors_array_shape": [
        8,
        7
      ],
      "actors_array_dtype": "float32",
      "validity_mask_shape": [
        8
      ],
      "validity_mask_dtype": "bool",
      "active_count_semantics": "number of valid selected actors in [0, capacity]",
      "overflow_count_semantics": "number of additional in-radius actors omitted because capacity was exceeded",
      "motion_paths": {
        "python_type": "tuple[ActorPathV1]",
        "max_per_actor": 8,
        "source_semantics": "Map-match observed actor pose/heading against road geometry; enumerate possible connected lane branches within 50 m ego radius and 50 m from actor; never reads actor lane/navigation/policy or its actual future route",
        "point_fields": [
          "distance_from_actor_m",
          "relative_x",
          "relative_y",
          "relative_heading"
        ],
        "actor_slot_semantics": "Association within current snapshot only, not a persistent ID",
        "overflow_semantics": "Discarded or unresolved road alternatives due to capacity/depth bound; conservative admission guard",
        "masked_in_core_only": true
      },
      "padding_semantics": "invalid slots zero-valued and validity_mask=False",
      "coordinate_frame": "ego-centric (forward +x, left +y)",
      "ordering": "Euclidean distance ascending with deterministic tie-breaking (distance, x_rel, y_rel)"
    },
    "task_context": {
      "lookahead_count": 20,
      "lookahead_spacing_m": 2.5,
      "lookahead_range_m": 50.0,
      "current_lane_width": {
        "python_type": "float",
        "units": "meters",
        "finite": true,
        "positive": true,
        "source_semantics": "current reference lane width from navigation.get_current_lane_width()",
        "mapsuite_v1_observed_standard_m": 3.5
      },
      "navigation_goal_direction": {
        "python_type": "tuple",
        "length": 2,
        "finite": true,
        "normalized_unit_norm": true,
        "source_semantics": "2D normalized direction unit vector towards active checkpoint"
      },
      "route_end_within_lookahead": {
        "python_type": "bool",
        "source_semantics": "Boolean flag indicating whether reference route terminates within lookahead window (NOT episode termination)"
      },
      "decision_point": {
        "python_type": "Optional[RoadDecisionPointV1]",
        "source_semantics": "Nearest local road fork from the ego lane within lookahead_range_m, independent of designated route; None for single-exit curves, dead ends, or masked CORE_ONLY_V1 context",
        "point_id": "Stable local road-node string identifying the fork approach",
        "distance_m": "Non-negative distance along the approach to the fork",
        "available_turns": "Immutable tuple of at least two distinct left/straight/right directions; excludes U-turns and deduplicates parallel lanes"
      },
      "route_passage": {
        "python_type": "Optional[RoutePassageV1]",
        "source_semantics": "Local designated-route intersection or roundabout merge/fork section from lane surface types and graph connectivity; no legal priority or stop-line inferred",
        "entry_distance_m": "Signed route distance to connector entry; negative inside",
        "exit_distance_m": "Signed local route distance to exit; None until within lookahead_range_m",
        "branch_id": "Stable selected connector lane indices; local identity only, no seed/tier/progress",
        "yield_distance_m": "Geometric yield boundary; roundabout approach may intersect other lane envelopes upstream of connector entry; not a legal stop line",
        "conflict_exit_distance_m": "End of the local conflict section; roundabout admission checks the inlet merge plus clearance, branch locking lasts through the circulation fork",
        "masked_in_core_only": true
      },
      "coordinate_frame": "ego-centric relative waypoints (lookahead_distance_m, relative_x, relative_y, relative_heading)",
      "waypoint_source_semantics": "Anchored to navigation.current_lane; subsequent route lanes minimize endpoint/heading discontinuity; gaps larger than current lane width are not exported",
      "waypoint_validity_semantics": "Invalid samples beyond a missing/disconnected connector do not imply route end; route_end_within_lookahead is true only when the actual final route edge is reached",
      "waypoints_tuple_length": 20,
      "waypoint_fields": [
        "lookahead_distance_m",
        "relative_x",
        "relative_y",
        "relative_heading"
      ],
      "waypoints_array_shape": [
        20,
        3
      ],
      "waypoints_array_dtype": "float32",
      "validity_mask_shape": [
        20
      ],
      "validity_mask_dtype": "bool",
      "evaluator_progress_metrics_excluded": true
    },
    "ego_motion": {
      "python_type": "Optional[EgoMotionV1]",
      "coordinate_frame": "current ego frame, forward +x, left +y",
      "source_semantics": "Local displacement and signed heading change since previous control step, local ego velocity and full signed current-lane heading error; no global position or heading",
      "masked_in_core_only": true
    }
  },
  "forbidden_evaluator_fields": [
    "arrive_dest",
    "candidate_role",
    "case_id",
    "case_result",
    "clean_success",
    "crash_building",
