# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
autonomous-driving-rl/env/
autonomous-driving-rl/ENV/

# IDE / Editor / OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# External MetaDrive source (defensively ignored if cloned or referenced locally)
metadrive-src/
**/metadrive-src/

# Autonomous driving subproject raw runs and transient artifacts
autonomous-driving-rl/runs/*
!autonomous-driving-rl/runs/.gitkeep

# Future model artifacts and checkpoints
autonomous-driving-rl/checkpoints/
autonomous-driving-rl/**/*.pt
autonomous-driving-rl/**/*.pth
autonomous-driving-rl/**/*.ckpt

# W&B runtime, local cache, and environment secrets
wandb/
**/wandb/
.env
.env.*
!.env.example

# Generated artifacts, with the packaged Agent4 PDD release available to Git.
autonomous-driving-rl/artifacts/*
!autonomous-driving-rl/artifacts/agent4_pdd/
autonomous-driving-rl/artifacts/agent4_pdd/*
!autonomous-driving-rl/artifacts/agent4_pdd/1.0.0/

# Local archive of earlier Agent4 experiments and their raw artifacts.
/.agent4-backup/

nii_notes/
AGENTS.md
